{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@cosmos-motion/core": ["packages/core/index.ts"],
      "@cosmos-motion/characters": ["packages/characters/index.ts"],
      "@cosmos-motion/geo-space": ["packages/geo-space/index.ts"],
      "@cosmos-motion/scenes": ["packages/scenes/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/**/*"]
}
