{
  "name": "cosmos-motion",
  "version": "0.1.0",
  "description": "Open-Source Science Documentary Video Engine (Remotion + Three.js + D3-Geo + OpenStreetMap + CLI) inspired by Cosmos: A Spacetime Odyssey.",
  "main": "dist/packages/index.js",
  "types": "dist/packages/index.d.ts",
  "bin": {
    "cosmos-motion": "./bin/cosmos-motion.js"
  },
  "files": [
    "bin/",
    "cli/",
    "dist/packages/",
    "packages/",
    "templates/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "build:lib": "tsc -p tsconfig.json",
    "build": "remotion bundle src/index.ts",
    "prepublishOnly": "npm run build:lib",
    "render:demo": "remotion render src/index.ts DemoDocumentary out/demo.mp4 --codec=h264 --crf=18 --gl=angle",
    "render:charsheet": "remotion still src/index.ts CharacterReferenceSheet out/character-sheet.png --gl=angle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EngRidhoNet/cosmos-motion.git"
  },
  "homepage": "https://github.com/EngRidhoNet/cosmos-motion#readme",
  "bugs": {
    "url": "https://github.com/EngRidhoNet/cosmos-motion/issues"
  },
  "keywords": [
    "cosmos",
    "science-documentary",
    "remotion",
    "threejs",
    "d3-geo",
    "openstreetmap",
    "ai-video",
    "education"
  ],
  "author": "EngRidhoNet",
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "@remotion/media-utils": "^4.0.543",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.3",
    "world-atlas": "^2.0.2"
  }
}
